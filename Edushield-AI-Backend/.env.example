# .env.example — copy to .env and fill in your values

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://edushield_user:edushield_password@localhost:5432/edushield_db

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT Authentication ────────────────────────────────────────────────────────
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-strong-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── AI / LLM API Keys ─────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AIza...

# ── Risk Thresholds ───────────────────────────────────────────────────────────
CRITICAL_RISK_THRESHOLD=0.75
HIGH_RISK_THRESHOLD=0.60
MODERATE_RISK_THRESHOLD=0.40

# ── Prediction Horizons (days) ────────────────────────────────────────────────
SHORT_TERM_DAYS=30
MEDIUM_TERM_DAYS=60
LONG_TERM_DAYS=90

# ── Model Versions ────────────────────────────────────────────────────────────
DROPOUT_MODEL_VERSION=v1.2.0
ENGAGEMENT_MODEL_VERSION=v1.1.0
